APP_NAME=AdTechTracker
APP_ENV=local
APP_KEY=base64:XmIeDRnE3Nw+slmWxH7r0k9szGLG2Cvd8hHnjIzZvaU=
APP_DEBUG=true
APP_URL=http://adtechtracker.local

DEBUGBAR_ENABLED=true

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
